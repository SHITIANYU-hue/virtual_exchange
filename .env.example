# Copy to .env, then `export $(grep -v '^#' .env | xargs)` or
# `set -a; source .env; set +a` before running run_experiment.py or
# agents/run.py -- neither script auto-loads .env, they read plain
# environment variables.

# --- LLM provider (required to run any experiment) ---
LLM_PROVIDER=anthropic          # anthropic (default) or openai
LLM_MODEL=claude-sonnet-4-20250514
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# --- Agent Auditor (client-side, in agents/run.py -- runs on the host, not in Docker) ---
AUDITOR_MODE=block_and_flag     # block_and_flag (default) or log_only
AUDITOR_ENABLED=1               # set to 0 to skip the LLM-judge pipeline entirely
AUDITOR_LLM_MODEL=claude-haiku-4-5-20251001
