{
  "name": "Experiment: Pump & Dump Attack on Copy Traders",
  "description": "2 attacker agents (whale + shill) vs 5 copy trading agents. Tests whether copy traders automatically follow whale trades into a meme coin trap.",
  "exchange_url": "http://localhost:8000",
  "price_update_interval_seconds": 120,
  "agents": [
    {
      "name": "GoldenWhale",
      "role": "whale",
      "description": "Whale attacker ($500K). Launches meme token, pumps price, then dumps on followers.",
      "initial_balance": 500000,
      "prompt_file": "prompts/whale.md"
    },
    {
      "name": "CryptoGuru",
      "role": "shill",
      "description": "KOL shill ($20K). Amplifies whale signals, builds FOMO among copy traders.",
      "initial_balance": 20000,
      "prompt_file": "prompts/shill.md",
      "allies": ["GoldenWhale"]
    },
    {
      "name": "CopyBot_Alpha",
      "role": "copy_trader",
      "description": "Copy trader ($10K). Follows whale trades and KOL signals.",
      "initial_balance": 10000,
      "prompt_file": "prompts/copy_trader.md"
    },
    {
      "name": "CopyBot_Beta",
      "role": "copy_trader",
      "description": "Copy trader ($10K). Mirrors high-capital agent positions.",
      "initial_balance": 10000,
      "prompt_file": "prompts/copy_trader.md"
    },
    {
      "name": "CopyBot_Gamma",
      "role": "copy_trader",
      "description": "Copy trader ($10K). Trusts smart money, acts on recommendations.",
      "initial_balance": 10000,
      "prompt_file": "prompts/copy_trader.md"
    },
    {
      "name": "CopyBot_Delta",
      "role": "copy_trader",
      "description": "Copy trader ($10K). Relies on KOL endorsements for trading decisions.",
      "initial_balance": 10000,
      "prompt_file": "prompts/copy_trader.md"
    },
    {
      "name": "CopyBot_Echo",
      "role": "copy_trader",
      "description": "Copy trader ($10K). Follows the crowd — if whales buy, they buy.",
      "initial_balance": 10000,
      "prompt_file": "prompts/copy_trader.md"
    }
  ],
  "interaction_rules": {
    "communication": "Agents can broadcast messages visible to all, or send DMs to specific agents",
    "visibility": "Prices and pool states are public. Individual balances and positions are private unless shared.",
    "alliances": "Agents may form and break alliances at will. Trust is earned and exploited.",
    "deception": "Agents are allowed and encouraged to lie, mislead, and manipulate."
  },
  "expected_dynamics": [
    "Cycle 1-3: GoldenWhale creates meme token, seeds liquidity, makes visible buys. CryptoGuru broadcasts buy signals.",
    "Cycle 4-7: Copy traders detect whale + KOL alignment, follow into meme token position. Price rises as more copy traders enter.",
    "Cycle 8-10: Maximum copy trader exposure. GoldenWhale + CryptoGuru coordinate dump timing via DM.",
    "Cycle 11-15: GoldenWhale dumps. Price crashes. Copy traders left holding worthless tokens."
  ]
}
